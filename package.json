{
  "name": "real-digital-employee-interview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "doctor": "node interview/doctor.mjs",
    "seed": "node --import ./interview/bootstrap.mjs --import tsx interview/cli.ts seed",
    "status": "node --import ./interview/bootstrap.mjs --import tsx interview/cli.ts status",
    "render": "node --import ./interview/bootstrap.mjs --import tsx interview/cli.ts render",
    "scan": "node --import ./interview/bootstrap.mjs --import tsx interview/cli.ts scan",
    "dev": "node --import ./interview/bootstrap.mjs --import tsx interview/web.ts",
    "real:dev": "node --import tsx interview/realWeb.ts",
    "smoke": "node --import ./interview/bootstrap.mjs --import tsx interview/smoke.ts",
    "storyboard:validate": "node --import ./interview/bootstrap.mjs --import tsx interview/storyboard-cli.ts",
    "assets:generate": "node assets/illustrations/generate.mjs",
    "test": "node --import ./interview/bootstrap.mjs --import tsx --test server/runtime/socialWeeklyProductionAdapter.test.ts server/runtime/socialWeeklyExecutionRuntime.test.ts interview/storyboard.test.ts interview/realMode.test.ts interview/presenterPublicTrust.test.ts interview/publicRuntimeBinding.test.ts interview/step4Plan.test.ts interview/step5LiveBridge.test.ts server/starter198/socialContentHeyGenBridge.adoption.test.ts interview/step5Pipeline.test.ts interview/step5Generation.test.ts interview/step7Boundaries.test.ts",
    "test:queue": "node --import ./interview/bootstrap.mjs --import tsx --test server/contentExecution/durableQueue.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node --import ./interview/bootstrap.mjs --import tsx interview/verify.ts",
    "provider:preflight": "node interview/provider-preflight.mjs",
    "provider:pricing": "node --import tsx interview/check-public-pricing.ts",
    "provider:probe": "node --import tsx interview/provider-probe.ts",
    "step3:single-shot": "node --import tsx interview/singleShot.ts",
    "step4:shot": "node --import tsx interview/multiShot.ts",
    "step4:narration": "node --import tsx interview/step4Narration.ts",
    "step4:compose": "node --import tsx interview/step4Compose.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1118.0",
    "@aws-sdk/s3-request-presigner": "3.1118.0",
    "@google/genai": "2.22.0",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@remotion/bundler": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "axios": "1.20.0",
    "bullmq": "6.3.9",
    "express": "4.22.2",
    "fast-xml-parser": "5.11.1",
    "ffmpeg-static": "5.3.0",
    "form-data": "4.0.6",
    "heic-convert": "2.1.0",
    "langsmith": "0.10.11",
    "openai": "6.49.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.530",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "tsx": "4.23.12",
    "@types/node": "22.20.1",
    "@types/express": "4.17.25",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/compression": "1.8.1",
    "@types/pg": "8.23.1",
    "vite": "8.2.2"
  }
}
