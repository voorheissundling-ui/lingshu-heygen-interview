  "codeFix": {
    "file": "server/contentExecution/durableQueue.ts",
    "reason": "Step 6 recovery run failed: the worker-id parser was ambiguous and classified a dead same-host worker as alive.",
    "oldPattern": "^(.+)-(\\d+)-[0-9a-f-]{20,}$",
    "newPattern": "^(.+)-(\\d+)-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
    "behavior": "The greedy host group could absorb a UUID prefix that is all digits (e.g. 91640a75-...), so localWorkerPid returned null, the same-host check was skipped, and an unexpired lease kept the dead worker's job in running forever. Parsing the UUID as a strict whole pins the PID segment and makes both abandoned-job recovery and stale-lease cleanup work.",
    "tests": [
      "worker id parser keeps a digit-led uuid out of the host segment",
      "dead local worker is recovered before its lease expires"
    ]
  },
